# ==============================================================================
# ServerMon - .gitignore
# ==============================================================================

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test, Coverage & Linter Artifacts
tests/
TEST_INFRA.md
TEST_READY.md
scripts/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Packaging & Build Outputs
graphify-out/
build/
dist/
dist-installer/
*.spec
*.egg-info/
*.egg
.eggs/
eggs/
parts/
var/
sdist/
wheels/
installed.cfg

# Runtime Logs, Data & Metrics
storage/*.log
*.log
logs/
config/log_metrics.json
*.tmp
*.bak
*.orig
*.swp
*.swo

# Network & Wireshark Capture Dumps
*.pcap
*.pcapng
*.cap
*.dump

# Local Environment & Secrets
.credentials.backup.json
*.backup.json
.env
.env.local
.env.*.local
*.key
*.pem
*.pfx
.gitattributes
.gitignore

# IDEs & Editor Configurations
.vscode/
.idea/
.agents/
.cursor/
*.code-workspace
*.sublime-project
*.sublime-workspace

# Operating System Artifacts
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
.DS_Store
.AppleDouble
.LSOverride
._*
.gitignore
