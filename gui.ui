/* Global Base Resets */

* {

    color: #f1f5f9;

    font-family: 'Segoe UI', -apple-system, Roboto, sans-serif;

    font-size: 13px;

}



QMainWindow, 

QWidget#centralwidget, 

QStackedWidget,

QWidget#pageDashboard, 

QWidget#pageServers, 

QWidget#pageServerDetail,

QWidget#pageLogs, 

QWidget#pageSettings, 

QWidget#pageServerForm {

    background-color: #0b111e;

}



QLabel {

    color: #f1f5f9;

    background: transparent;

}



/* Navigation Sidebar */

QFrame#sidebarFrame {

    background-color: #0f172a;

    border-right: 1px solid #1e293b;

}



QLabel#lblBrandTitle {

    color: #ffffff;

    font-size: 17px;

    font-weight: 700;

}



QLabel#lblBrandSubtitle, 

QLabel#lblUserStatus {

    color: #64748b;

    font-size: 11px;

    font-weight: 500;

}



QPushButton#btnNavDashboard, 

QPushButton#btnNavServers, 

QPushButton#btnNavDetails,

QPushButton#btnNavLogs, 

QPushButton#btnNavSettings {

    text-align: left;

    padding: 10px 16px;

    border-radius: 8px;

    border: none;

    font-weight: 600;

    color: #94a3b8;

    background-color: transparent;

}



QPushButton#btnNavDashboard:hover, 

QPushButton#btnNavServers:hover, 

QPushButton#btnNavDetails:hover,

QPushButton#btnNavLogs:hover, 

QPushButton#btnNavSettings:hover {

    background-color: #1e293b;

    color: #f8fafc;

}



QFrame#userProfileFrame {

    background-color: #131d33;

    border-radius: 8px;

}



/* Header Controls */

QFrame#topHeaderFrame {

    background-color: #0f172a;

    border-bottom: 1px solid #1e293b;

}



QLineEdit, 

QComboBox, 

QSpinBox,
QDoubleSpinBox {
    background-color: #1e293b;

    border: 1px solid #334155;

    border-radius: 8px;

    padding: 6px 12px;

    color: #f8fafc;

}



QLineEdit:focus, 

QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {

    border: 1px solid #3b82f6;

}



QComboBox QAbstractItemView,
QComboBox QListView {
    background-color: #1e293b;
    color: #f8fafc;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    border: 1px solid #334155;
    outline: 0px;
}

QComboBox QAbstractItemView::item,
QComboBox QListView::item {
    background-color: #1e293b;
    color: #f8fafc;
    padding: 6px 10px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QListView::item:selected,
QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover {
    background-color: #2563eb;
    color: #ffffff;
}



QLabel#lblLastCheckedHeader {

    color: #94a3b8;

    font-weight: 500;

    font-size: 12px;

}



/* Buttons */

QPushButton#btnAddDevice, 

QPushButton#btnPageAddDevice,

QPushButton#btnDetailRunChecks, 

QPushButton#btnFormSave {

    background-color: #2563eb;

    color: #ffffff;

    border: none;

    border-radius: 8px;

    padding: 8px 18px;

    font-weight: 600;

}



QPushButton#btnAddDevice:hover, 

QPushButton#btnPageAddDevice:hover,

QPushButton#btnDetailRunChecks:hover, 

QPushButton#btnFormSave:hover {

    background-color: #1d4ed8;

}



QPushButton#btnCheckNow, 

QPushButton#btnManualCheckNow,

QPushButton#btnDetailTestIcmp, 

QPushButton#btnDetailTestTcp {

    background-color: #10b981;

    color: #ffffff;

    border: none;

    border-radius: 8px;

    padding: 8px 16px;

    font-weight: 600;

}



QPushButton#btnCheckNow:hover, 

QPushButton#btnManualCheckNow:hover,

QPushButton#btnDetailTestIcmp:hover, 

QPushButton#btnDetailTestTcp:hover {

    background-color: #059669;

}



QPushButton#btnEditDevice, 

QPushButton#btnDeleteDevice,

QPushButton#btnDetailBackToServers, 

QPushButton#btnManualRefreshLogs,

QPushButton#btnFormCancel {

    background-color: #1e293b;

    border: 1px solid #334155;

    border-radius: 8px;

    padding: 8px 14px;

    font-weight: 600;

    color: #e2e8f0;

}



QPushButton#btnEditDevice:hover, 

QPushButton#btnDetailBackToServers:hover,

QPushButton#btnManualRefreshLogs:hover, 

QPushButton#btnFormCancel:hover {

    background-color: #334155;

}



QPushButton#btnDeleteDevice:hover {

    background-color: #dc2626;

    border-color: #ef4444;

}



/* Cards and Containers */

QFrame#cardTotal, 

QFrame#cardOnline, 

QFrame#cardOffline, 

QFrame#cardLatency,

QFrame#recentServersFrame, 

QFrame#quickInspectorFrame,

QFrame#cardDetLat, 

QFrame#cardDetIcmp, 

QFrame#cardDetTcp, 

QFrame#cardDetDelta, 

QFrame#cardDetAvgLat, 

QFrame#cardDetUptime, 

QFrame#cardDetTcpChecks,

QFrame#cardDetPingChecks,
QFrame#boxInspPing,
QFrame#boxInspTcp,
QFrame#boxInspHttp,
QFrame#boxInspSslDns,
QFrame#boxInspSnmp,
QFrame#boxInspGauges,
QFrame#boxInspTraffic,
QFrame#panelNetworkSpecs, 

QFrame#panelHardwareSlots, 

QFrame#frameFormCard {

    background-color: #131d33;

    border: 1px solid #1e293b;

    border-radius: 12px;

}



/* Primary Metric Numbers */

QLabel#lblValTotal { color: #f8fafc; font-size: 24px; font-weight: 700; }

QLabel#lblValOnline { color: #10b981; font-size: 24px; font-weight: 700; }

QLabel#lblValOffline { color: #ef4444; font-size: 24px; font-weight: 700; }

QLabel#lblValLatency { color: #38bdf8; font-size: 24px; font-weight: 700; }

QLabel#lblValDetLat { color: #38bdf8; font-size: 24px; font-weight: 700; }

QLabel#lblValDetIcmpLat { color: #34d399; font-size: 15px; font-weight: 700; }

QLabel#lblValDetTcpLat { color: #38bdf8; font-size: 15px; font-weight: 700; }

QLabel#lblValDetDelta { color: #fbbf24; font-size: 24px; font-weight: 700; }

QLabel#lblValDetAvgLat { color: #a855f7; font-size: 24px; font-weight: 700; }

QLabel#lblValDetUptime { color: #10b981; font-size: 24px; font-weight: 700; }

QLabel#lblValDetTcpChecks { color: #38bdf8; font-size: 24px; font-weight: 700; }

QLabel#lblValDetPingChecks { color: #34d399; font-size: 24px; font-weight: 700; }



QLabel#lblTitleTotal, 

QLabel#lblTitleOnline, 

QLabel#lblTitleOffline, 

QLabel#lblTitleLatency,

QLabel#lblTitleDetLat, 

QLabel#lblTitleDetIcmp, 

QLabel#lblTitleDetTcp, 

QLabel#lblTitleDetDelta, 

QLabel#lblTitleDetAvgLat, 

QLabel#lblTitleDetUptime, 

QLabel#lblTitleDetTcpChecks,

QLabel#lblTitleDetPingChecks,

QLabel#lblRecentSubtitle, 

QLabel#lblInspectorSub, 

QLabel#lblServersMainSubtitle,

QLabel#lblDashSubtitle, 

QLabel#lblFormSubtitle, 

QLabel#lblSlotDesc, 

QLabel#lblTotalCountSummary,

QLabel#lblInfoStats, 

QLabel#lblQuickSelect {

    color: #94a3b8;

}



QLabel#lblDashTitle, 

QLabel#lblServersMainTitle, 

QLabel#lblLogsTitle,

QLabel#lblSettingsTitle, 

QLabel#lblFormTitle, 

QLabel#lblDetServerName,

QLabel#lblRecentTitle, 

QLabel#lblInspectorTitle, 

QLabel#lblSpecHeader, 

QLabel#lblSlotHeader {

    color: #ffffff;

    font-size: 18px;

    font-weight: 700;

}



QLabel#lblInfoResolved, 

QLabel#lblInfoIcmp, 

QLabel#lblInfoTcp {

    color: #cbd5e1;

    font-weight: 500;

}



/* Tables and Headers */

QTableWidget, 

QTableView {

    background-color: #131d33;

    border: 1px solid #1e293b;

    border-radius: 8px;

    gridline-color: #1e293b;

    color: #f1f5f9;

    selection-background-color: #1e293b;

    selection-color: #38bdf8;

    outline: none;

}



QTableWidget::item, 

QTableView::item {

    color: #f1f5f9;

    padding: 8px;

    border-bottom: 1px solid #1e293b;

}



QHeaderView {

    background-color: #0f172a;

    border: none;

    border-bottom: 1px solid #1e293b;

    min-height: 38px;

}



QHeaderView::section {

    background-color: #0f172a;

    color: #94a3b8;

    font-size: 12px;

    font-weight: 600;

    border: none;

    border-bottom: 1px solid #1e293b;

    padding: 4px 10px;

    min-height: 38px;

}



QTableCornerButton::section {

    background-color: #0f172a;

    border: none;

}



/* Progress Bars */

QProgressBar {

    background-color: #1e293b;

    border: 1px solid #334155;

    border-radius: 6px;

    text-align: center;

    color: #ffffff;

    font-weight: 600;

    height: 18px;

}



QProgressBar::chunk {

    background-color: #3b82f6;

    border-radius: 5px;

}



/* Dialogs */

QMessageBox, QDialog {

    background-color: #0f172a;

    border: 1px solid #1e293b;

    border-radius: 8px;

}



QMessageBox QLabel {

    color: #f1f5f9;

    font-size: 13px;

    font-weight: 500;

    background: transparent;

}



QMessageBox QPushButton {

    background-color: #1e293b;

    color: #f8fafc;

    border: 1px solid #334155;

    border-radius: 6px;

    padding: 6px 18px;

    min-width: 65px;

    font-weight: 600;

    font-size: 12px;

}



QMessageBox QPushButton:hover {

    background-color: #2563eb;

    border-color: #3b82f6;

    color: #ffffff;

}



QMessageBox QPushButton:pressed {

    background-color: #1d4ed8;

}

   

/* =========================================================================
   QTABWIDGET AND QTABBAR MODERN DARK STYLING
   ========================================================================= */
QPushButton#btnDetailRunChecks:disabled {
    background-color: #1e293b;
    color: #64748b;
    border: 1px solid #334155;
}

QTabWidget {
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid #1e293b;
    border-radius: 8px;
    background-color: #0b111e;
    top: -1px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #131d33;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-weight: 600;
    font-size: 12px;
}

QTabBar::tab:hover {
    background-color: #1e293b;
    color: #f8fafc;
}

QTabBar::tab:selected {
    background-color: #0b111e;
    color: #38bdf8;
    border: 1px solid #1e293b;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* Tab pages and Inner Containers */
QWidget#tabNetworkLink,
QWidget#tabWebServices,
QWidget#tabHostHardware,
QWidget#tabTrafficSecurity,
QWidget#tabFormPing,
QWidget#tabFormTcp,
QWidget#tabFormHttp,
QWidget#tabFormHttps,
QWidget#tabFormDns,
QWidget#tabFormSnmp,
QWidget#tabFormTraffic {
    background-color: #0b111e;
    border: none;
}

QWidget#containerPing,
QWidget#containerTcp,
QWidget#containerHttp,
QWidget#containerHttps,
QWidget#containerDns,
QWidget#containerSnmp,
QWidget#containerTraffic {
    background-color: transparent;
}

QScrollArea#scrollServerForm {
    background: transparent;
    border: none;
}

QScrollArea#scrollServerForm > QWidget > QWidget {
    background: transparent;
}

