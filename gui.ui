                  <item><widget class="QSpinBox" name="spnFormPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>80</number></property></widget></item>

                 </layout>

                </item>

               </layout>

              </item>



              <item><widget class="QLabel" name="lblFormPortHint"><property name="text"><string>Note: For ICMP Ping tests, port numbers are not applicable.</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>



              <item>

