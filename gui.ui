                    <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                    <item><widget class="QLabel" name="lblValSlotMemory"><property name="text"><string>0%</string></property><property name="styleSheet"><string notr="true">color: #38bdf8; font-weight: 700;</string></property></widget></item>
                   </layout>
                  </item>
                  <item>
                   <widget class="QProgressBar" name="barSlotMemory">
                    <property name="maximum"><number>100</number></property>
                    <property name="value"><number>0</number></property>
                    <property name="styleSheet"><string notr="true">QProgressBar { border: 1px solid #1e293b; border-radius: 4px; background: #0f172a; height: 10px; text-align: center; } QProgressBar::chunk { background-color: #38bdf8; border-radius: 4px; }</string></property>
                   </widget>
                  </item>

                  <!-- Disk Gauge -->
                  <item>
                   <layout class="QHBoxLayout">
                    <item><widget class="QLabel" name="lblTitleSlotDisk"><property name="text"><string>Disk Storage</string></property><property name="styleSheet"><string notr="true">color: #cbd5e1; font-weight: 600;</string></property></widget></item>
                    <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                    <item><widget class="QLabel" name="lblValSlotDisk"><property name="text"><string>0%</string></property><property name="styleSheet"><string notr="true">color: #10b981; font-weight: 700;</string></property></widget></item>
                   </layout>
                  </item>
                  <item>
                   <widget class="QProgressBar" name="barSlotDisk">
                    <property name="maximum"><number>100</number></property>
                    <property name="value"><number>0</number></property>
                    <property name="styleSheet"><string notr="true">QProgressBar { border: 1px solid #1e293b; border-radius: 4px; background: #0f172a; height: 10px; text-align: center; } QProgressBar::chunk { background-color: #10b981; border-radius: 4px; }</string></property>
                   </widget>
                  </item>

                  <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
                 </layout>
                </widget>
               </item>
              </layout>
             </widget>

             <!-- TAB 4: Traffic & Security (Wireshark Anomaly) -->
             <widget class="QWidget" name="tabTrafficSecurity">
              <attribute name="title"><string>Traffic and Security</string></attribute>
              <layout class="QVBoxLayout" name="layTabTrafficSecurity">
               <property name="spacing"><number>10</number></property>
               <property name="leftMargin"><number>10</number></property>
               <property name="topMargin"><number>10</number></property>
               <property name="rightMargin"><number>10</number></property>
               <property name="bottomMargin"><number>10</number></property>

               <!-- Dependency Alert Banner -->
               <item>
                <widget class="QFrame" name="bannerWireshark">
                 <property name="styleSheet"><string notr="true">background-color: #451a03; border: 1px solid #b45309; border-radius: 8px; padding: 10px;</string></property>
                 <layout class="QHBoxLayout" name="layBannerWireshark">
                  <item><widget class="QLabel" name="lblWiresharkStatus"><property name="text"><string>Wireshark (tshark.exe) status: scanning...</string></property><property name="styleSheet"><string notr="true">color: #fde68a; font-weight: 600;</string></property></widget></item>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                  <item><widget class="QPushButton" name="btnRecheckWireshark"><property name="text"><string>Re-check Wireshark</string></property><property name="styleSheet"><string notr="true">background-color: #d97706; color: #ffffff; font-weight: 700; padding: 6px 14px; border-radius: 6px;</string></property></widget></item>
                 </layout>
                </widget>
               </item>

               <!-- Security & Anomaly Box -->
               <item>
                <widget class="QFrame" name="boxInspTraffic">
                 <layout class="QVBoxLayout" name="layBoxTraffic">
                  <property name="leftMargin"><number>16</number></property>
                  <property name="topMargin"><number>14</number></property>
                  <property name="rightMargin"><number>16</number></property>
                  <property name="bottomMargin"><number>14</number></property>
                  <property name="spacing"><number>10</number></property>
                  <item>
                   <layout class="QHBoxLayout">
                    <item><widget class="QLabel" name="lblThreatBadge"><property name="text"><string>SECURITY: NORMAL</string></property><property name="styleSheet"><string notr="true">background-color: #064e3b; color: #34d399; font-weight: 700; padding: 4px 12px; border-radius: 6px;</string></property></widget></item>
                    <item><widget class="QPushButton" name="btnTestTraffic"><property name="text"><string>Test Traffic</string></property><property name="styleSheet"><string notr="true">background-color: #1e293b; color: #f59e0b; border: 1px solid #f59e0b; border-radius: 6px; padding: 3px 10px; font-size: 11px; font-weight: 600;</string></property></widget></item>
                    <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                    <item><widget class="QLabel" name="lblTrafficPPS"><property name="text"><string>0 PPS (Peak: 0 PPS)</string></property><property name="styleSheet"><string notr="true">color: #f43f5e; font-weight: 700; font-size: 13px;</string></property></widget></item>
                   </layout>
                  </item>
                  <item><widget class="QLabel" name="lblThreatDetails"><property name="text"><string>Heuristics: Normal packet flow. No SYN flood or port sweep detected.</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-size: 12px;</string></property></widget></item>
                  <item>
                   <layout class="QVBoxLayout" name="layoutTrafficGraph"/>
                  </item>
                 </layout>
                </widget>
               </item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>

         <!-- Page 3: Audit Logs -->

         <widget class="QWidget" name="pageLogs">

          <layout class="QVBoxLayout" name="p3_layout">

           <property name="spacing"><number>12</number></property>

           <property name="leftMargin"><number>24</number></property>

           <property name="topMargin"><number>20</number></property>

           <property name="rightMargin"><number>24</number></property>

           <property name="bottomMargin"><number>20</number></property>



           <item>

            <layout class="QHBoxLayout">

             <item><widget class="QLabel" name="lblLogsTitle"><property name="text"><string>Activity Logs</string></property></widget></item>

             <item><spacer name="spLogsHeader"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>

             <item><widget class="QPushButton" name="btnManualRefreshLogs"><property name="text"><string>Refresh Logs</string></property></widget></item>

            </layout>

           </item>



           <item>

            <widget class="QTextEdit" name="txt_audit_logs">

             <property name="readOnly"><bool>true</bool></property>

             <property name="styleSheet"><string notr="true">background-color: #0f172a; color: #38bdf8; font-family: 'Consolas', monospace; font-size: 12px; border: 1px solid #1e293b; border-radius: 8px; padding: 12px;</string></property>

            </widget>

           </item>

          </layout>

         </widget>



         <!-- Page 4: Settings -->

         <widget class="QWidget" name="pageSettings">

          <layout class="QVBoxLayout" name="p4_layout">

           <property name="spacing"><number>16</number></property>

           <property name="leftMargin"><number>24</number></property>

           <property name="topMargin"><number>20</number></property>

           <property name="rightMargin"><number>24</number></property>

           <property name="bottomMargin"><number>20</number></property>



           <item><widget class="QLabel" name="lblSettingsTitle"><property name="text"><string>System Settings</string></property></widget></item>

           <item><widget class="QLabel" name="lblSettingsDesc"><property name="text"><string>Configure check intervals, worker thread pool, and resource monitor refresh rate.</string></property></widget></item>

           <item><spacer name="spSettingsBottom"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>

          </layout>

         </widget>



         <!-- Page 5: Server Configuration Form -->
         <widget class="QWidget" name="pageServerForm">
          <layout class="QVBoxLayout" name="p5_layout">
           <property name="spacing"><number>14</number></property>
           <property name="leftMargin"><number>24</number></property>
           <property name="topMargin"><number>20</number></property>
           <property name="rightMargin"><number>24</number></property>
           <property name="bottomMargin"><number>20</number></property>
           <item>
            <widget class="QScrollArea" name="scrollServerForm">
             <property name="widgetResizable"><bool>true</bool></property>
             <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
             
             <widget class="QWidget" name="scrollServerFormContent">
              <property name="geometry"><rect><x>0</x><y>0</y><width>840</width><height>860</height></rect></property>
              <layout class="QVBoxLayout" name="scrollFormLayout">
               <property name="spacing"><number>14</number></property>
               <property name="leftMargin"><number>0</number></property>
               <property name="topMargin"><number>0</number></property>
               <property name="rightMargin"><number>12</number></property>
               <property name="bottomMargin"><number>12</number></property>
               <item><widget class="QLabel" name="lblFormTitle"><property name="text"><string>Server Details</string></property></widget></item>
               <item><widget class="QLabel" name="lblFormSubtitle"><property name="text"><string>Set target host, primary service port, and configure verification checks in the tabs below.</string></property></widget></item>
               <item>
                <widget class="QFrame" name="frameFormCard">
                 <property name="maximumSize"><size><width>860</width><height>16777215</height></size></property>
                 <layout class="QVBoxLayout">
                  <property name="spacing"><number>14</number></property>
                  <property name="leftMargin"><number>24</number></property>
                  <property name="topMargin"><number>20</number></property>
                  <property name="rightMargin"><number>24</number></property>
                  <property name="bottomMargin"><number>20</number></property>

                  <!-- 1. GENERAL IDENTITY -->
                  <item><widget class="QLabel"><property name="text"><string>Server Name:</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                  <item><widget class="QLineEdit" name="txtFormName"><property name="placeholderText"><string>e.g., Primary Web Gateway, Database Cluster...</string></property></widget></item>

                  <item><widget class="QLabel"><property name="text"><string>Host Address (Domain or IP):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                  <item><widget class="QLineEdit" name="txtFormHost"><property name="placeholderText"><string>e.g., google.com or 192.168.1.1</string></property></widget></item>

                  <item>
                   <layout class="QHBoxLayout">
                    <property name="spacing"><number>14</number></property>
                    <item>
                     <layout class="QVBoxLayout">
                      <item><widget class="QLabel"><property name="text"><string>Primary Protocol:</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                      <item><widget class="QComboBox" name="cmbFormType"><item><property name="text"><string>TCP</string></property></item><item><property name="text"><string>PING</string></property></item><item><property name="text"><string>HTTP</string></property></item><item><property name="text"><string>HTTPS</string></property></item><item><property name="text"><string>DNS</string></property></item><item><property name="text"><string>SNMP</string></property></item><item><property name="text"><string>TRAFFIC</string></property></item></widget></item>
                     </layout>
                    </item>
                    <item>
                     <layout class="QVBoxLayout">
                      <item><widget class="QLabel"><property name="text"><string>Default Port (1 - 65535):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                      <item><widget class="QSpinBox" name="spnFormPort"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>80</number></property></widget></item>
                     </layout>
                    </item>
                   </layout>
                  </item>

                  <item><widget class="QLabel" name="lblFormPortHint"><property name="text"><string>Default port for TCP service is 80 (HTTP) or custom port.</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>

                  <!-- 2. MODULAR PROTOCOL CHECK TABS (EACH WITH ITS OWN PILL TOGGLE & BLUR OVERLAY) -->
                  <item><widget class="QLabel" name="lblFormProtocolConfigTitle"><property name="text"><string>Modular Verification Checks:</string></property><property name="styleSheet"><string notr="true">font-weight: 600; color: #f8fafc; margin-top: 6px;</string></property></widget></item>
                  <item>
                   <widget class="QTabWidget" name="tabsFormChecks">
                    <property name="currentIndex"><number>1</number></property>

                    <!-- TAB 0: PING -->
                    <widget class="QWidget" name="tabFormPing">
                     <attribute name="title"><string>Ping (ICMP)</string></attribute>
                     <layout class="QVBoxLayout" name="layoutTabPing">
                      <property name="spacing"><number>12</number></property>
                      <property name="leftMargin"><number>16</number></property>
                      <property name="topMargin"><number>14</number></property>
                      <property name="rightMargin"><number>16</number></property>
                      <property name="bottomMargin"><number>14</number></property>
                      
                      <!-- HEADER BAR WITH PILL TOGGLE -->
                      <item>
                       <widget class="QFrame" name="headerBarPing">
                        <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 8px; padding: 8px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item>
                          <layout class="QVBoxLayout">
                           <property name="spacing"><number>2</number></property>
                           <item><widget class="QLabel"><property name="text"><string>ICMP Ping Verification</string></property><property name="styleSheet"><string notr="true">font-size: 13px; font-weight: 700; color: #f8fafc;</string></property></widget></item>
                           <item><widget class="QLabel"><property name="text"><string>Measures round-trip latency (RTT), packet drop rate %, and jitter.</string></property><property name="styleSheet"><string notr="true">font-size: 11px; color: #94a3b8;</string></property></widget></item>
                          </layout>
                         </item>
                         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                         <item>
                          <widget class="QCheckBox" name="chkPing">
                           <property name="text"><string>○ DISABLED</string></property>
                           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                           <property name="styleSheet"><string notr="true">QCheckBox { font-size: 11px; font-weight: 700; color: #64748b; background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 6px 14px; } QCheckBox:hover { color: #94a3b8; background-color: #1e293b; border: 1px solid #475569; } QCheckBox::indicator { width: 0px; height: 0px; }</string></property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                      </item>

                      <!-- DISABLED OVERLAY BANNER -->
                      <item>
                       <widget class="QFrame" name="bannerDisabledPing">
                        <property name="styleSheet"><string notr="true">background-color: rgba(30, 41, 59, 0.7); border: 1px dashed #475569; border-radius: 8px; padding: 10px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item><widget class="QLabel"><property name="text"><string>🔒  Ping check is currently turned off for this server. Click the toggle above to activate and configure.</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-size: 12px; font-weight: 500;</string></property></widget></item>
                        </layout>
                       </widget>
                      </item>

                      <!-- CONFIG INPUTS CONTAINER -->
                      <item>
                       <widget class="QWidget" name="containerPing">
                        <layout class="QVBoxLayout">
                         <property name="leftMargin"><number>0</number></property>
                         <property name="rightMargin"><number>0</number></property>
                         <property name="topMargin"><number>4</number></property>
                         <property name="bottomMargin"><number>0</number></property>
                         <property name="spacing"><number>12</number></property>
                         <item>
                          <layout class="QHBoxLayout">
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Echo Request Count:</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QSpinBox" name="spnFormPingCount"><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property><property name="value"><number>4</number></property></widget></item>
                            </layout>
                           </item>
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Timeout per Packet (ms):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QSpinBox" name="spnFormPingTimeout"><property name="minimum"><number>100</number></property><property name="maximum"><number>10000</number></property><property name="singleStep"><number>100</number></property><property name="value"><number>1000</number></property></widget></item>
                            </layout>
                           </item>
                          </layout>
                         </item>
                        </layout>
                       </widget>
                      </item>
                      <item><spacer name="spTabPing"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
                     </layout>
                    </widget>

                    <!-- TAB 1: TCP -->
                    <widget class="QWidget" name="tabFormTcp">
                     <attribute name="title"><string>TCP Ports</string></attribute>
                     <layout class="QVBoxLayout" name="layoutTabTcp">
                      <property name="spacing"><number>12</number></property>
                      <property name="leftMargin"><number>16</number></property>
                      <property name="topMargin"><number>14</number></property>
                      <property name="rightMargin"><number>16</number></property>
                      <property name="bottomMargin"><number>14</number></property>

                      <!-- HEADER BAR WITH PILL TOGGLE -->
                      <item>
                       <widget class="QFrame" name="headerBarTcp">
                        <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 8px; padding: 8px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item>
                          <layout class="QVBoxLayout">
                           <property name="spacing"><number>2</number></property>
                           <item><widget class="QLabel"><property name="text"><string>TCP Port Connection Verification</string></property><property name="styleSheet"><string notr="true">font-size: 13px; font-weight: 700; color: #f8fafc;</string></property></widget></item>
                           <item><widget class="QLabel"><property name="text"><string>Tests TCP three-way handshake across single or multiple comma-separated service ports.</string></property><property name="styleSheet"><string notr="true">font-size: 11px; color: #94a3b8;</string></property></widget></item>
                          </layout>
                         </item>
                         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                         <item>
                          <widget class="QCheckBox" name="chkTcp">
                           <property name="checked"><bool>true</bool></property>
                           <property name="text"><string>● ACTIVE</string></property>
                           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                           <property name="styleSheet"><string notr="true">QCheckBox { font-size: 11px; font-weight: 700; color: #10b981; background-color: rgba(16, 185, 129, 0.15); border: 1px solid #059669; border-radius: 6px; padding: 6px 14px; } QCheckBox:hover { background-color: rgba(16, 185, 129, 0.25); border: 1px solid #10b981; } QCheckBox::indicator { width: 0px; height: 0px; }</string></property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                      </item>

                      <!-- DISABLED OVERLAY BANNER -->
                      <item>
                       <widget class="QFrame" name="bannerDisabledTcp">
                        <property name="styleSheet"><string notr="true">background-color: rgba(30, 41, 59, 0.7); border: 1px dashed #475569; border-radius: 8px; padding: 10px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item><widget class="QLabel"><property name="text"><string>🔒  TCP check is currently turned off for this server. Click the toggle above to activate and configure.</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-size: 12px; font-weight: 500;</string></property></widget></item>
                        </layout>
                       </widget>
                      </item>

                      <!-- CONFIG INPUTS CONTAINER -->
                      <item>
                       <widget class="QWidget" name="containerTcp">
                        <layout class="QVBoxLayout">
                         <property name="leftMargin"><number>0</number></property>
                         <property name="rightMargin"><number>0</number></property>
                         <property name="topMargin"><number>4</number></property>
                         <property name="bottomMargin"><number>0</number></property>
                         <property name="spacing"><number>12</number></property>
                         <item>
                          <layout class="QHBoxLayout">
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Target Port(s) (comma-separated):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QLineEdit" name="txtFormTcpPorts"><property name="placeholderText"><string>e.g. 80, 443, 22 (or leave blank to use primary port)</string></property></widget></item>
                            </layout>
                           </item>
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Connect Timeout (sec):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QDoubleSpinBox" name="spnFormTcpTimeout"><property name="minimum"><double>0.5</double></property><property name="maximum"><double>30.0</double></property><property name="singleStep"><double>0.5</double></property><property name="value"><double>3.0</double></property></widget></item>
                            </layout>
                           </item>
                          </layout>
                         </item>
                        </layout>
                       </widget>
                      </item>
                      <item><spacer name="spTabTcp"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
                     </layout>
                    </widget>

                    <!-- TAB 2: HTTP -->
                    <widget class="QWidget" name="tabFormHttp">
                     <attribute name="title"><string>HTTP Web</string></attribute>
                     <layout class="QVBoxLayout" name="layoutTabHttp">
                      <property name="spacing"><number>12</number></property>
                      <property name="leftMargin"><number>16</number></property>
                      <property name="topMargin"><number>14</number></property>
                      <property name="rightMargin"><number>16</number></property>
                      <property name="bottomMargin"><number>14</number></property>

                      <!-- HEADER BAR WITH PILL TOGGLE -->
                      <item>
                       <widget class="QFrame" name="headerBarHttp">
                        <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 8px; padding: 8px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item>
                          <layout class="QVBoxLayout">
                           <property name="spacing"><number>2</number></property>
                           <item><widget class="QLabel"><property name="text"><string>HTTP Web Endpoint Verification</string></property><property name="styleSheet"><string notr="true">font-size: 13px; font-weight: 700; color: #f8fafc;</string></property></widget></item>
                           <item><widget class="QLabel"><property name="text"><string>Validates plain HTTP endpoint availability, HTTP status codes, and redirection chains.</string></property><property name="styleSheet"><string notr="true">font-size: 11px; color: #94a3b8;</string></property></widget></item>
                          </layout>
                         </item>
                         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                         <item>
                          <widget class="QCheckBox" name="chkHttp">
                           <property name="text"><string>○ DISABLED</string></property>
                           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
                           <property name="styleSheet"><string notr="true">QCheckBox { font-size: 11px; font-weight: 700; color: #64748b; background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 6px 14px; } QCheckBox:hover { color: #94a3b8; background-color: #1e293b; border: 1px solid #475569; } QCheckBox::indicator { width: 0px; height: 0px; }</string></property>
                          </widget>
                         </item>
                        </layout>
                       </widget>
                      </item>

                      <!-- DISABLED OVERLAY BANNER -->
                      <item>
                       <widget class="QFrame" name="bannerDisabledHttp">
                        <property name="styleSheet"><string notr="true">background-color: rgba(30, 41, 59, 0.7); border: 1px dashed #475569; border-radius: 8px; padding: 10px 14px;</string></property>
                        <layout class="QHBoxLayout">
                         <item><widget class="QLabel"><property name="text"><string>🔒  HTTP check is currently turned off for this server. Click the toggle above to activate and configure.</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-size: 12px; font-weight: 500;</string></property></widget></item>
                        </layout>
                       </widget>
                      </item>

                      <!-- CONFIG INPUTS CONTAINER -->
                      <item>
                       <widget class="QWidget" name="containerHttp">
                        <layout class="QVBoxLayout">
