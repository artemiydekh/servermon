                         <property name="spacing"><number>12</number></property>
                         <item>
                          <layout class="QHBoxLayout">
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Capture Interface:</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QLineEdit" name="txtFormTrafficInterface"><property name="text"><string>any</string></property><property name="placeholderText"><string>e.g. any, Ethernet, or adapter name</string></property></widget></item>
                            </layout>
                           </item>
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Capture Duration (sec):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QDoubleSpinBox" name="spnFormTrafficDuration"><property name="minimum"><double>1.0</double></property><property name="maximum"><double>30.0</double></property><property name="singleStep"><double>0.5</double></property><property name="value"><double>3.0</double></property></widget></item>
                            </layout>
                           </item>
                          </layout>
                         </item>
                         <item>
                          <layout class="QHBoxLayout">
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>SYN Flood Threshold (PPS):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QDoubleSpinBox" name="spnFormTrafficSynThreshold"><property name="minimum"><double>1.0</double></property><property name="maximum"><double>1000.0</double></property><property name="singleStep"><double>5.0</double></property><property name="value"><double>50.0</double></property></widget></item>
                            </layout>
                           </item>
                           <item>
                            <layout class="QVBoxLayout">
                             <item><widget class="QLabel"><property name="text"><string>Port Sweep Threshold (ports):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                             <item><widget class="QSpinBox" name="spnFormTrafficSweepThreshold"><property name="minimum"><number>2</number></property><property name="maximum"><number>100</number></property><property name="value"><number>10</number></property></widget></item>
                            </layout>
                           </item>
                          </layout>
                         </item>
                         <item>
                          <layout class="QVBoxLayout">
                           <item><widget class="QLabel"><property name="text"><string>Custom TShark Executable Path (Optional):</string></property><property name="styleSheet"><string notr="true">font-weight: 600;</string></property></widget></item>
                           <item><widget class="QLineEdit" name="txtFormTrafficTsharkPath"><property name="placeholderText"><string>Auto-discovered from PATH / Program Files if left blank</string></property></widget></item>
                          </layout>
                         </item>
                        </layout>
                       </widget>
                      </item>
                      <item><spacer name="spTabTraffic"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
                     </layout>
                    </widget>
                   </widget>
                  </item>

                  <!-- 3. ACTION BUTTONS -->
                  <item>
                   <layout class="QHBoxLayout">
                    <property name="topMargin"><number>12</number></property>
                    <item><widget class="QPushButton" name="btnFormSave"><property name="text"><string>Save Server</string></property></widget></item>
                    <item><widget class="QPushButton" name="btnFormCancel"><property name="text"><string>Cancel</string></property></widget></item>
                    <item><spacer name="spFormButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   </layout>
                  </item>
                 </layout>
                </widget>
               </item>
               <item><spacer name="spScrollFormBottom"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
              </layout>
             </widget>
            </widget>
           </item>
          </layout>
         </widget>

          <!-- Page 6: System Resource Monitor -->

          <widget class="QWidget" name="pageResources">

           <layout class="QVBoxLayout" name="p6_layout">

            <property name="spacing"><number>18</number></property>

            <property name="leftMargin"><number>28</number></property>

            <property name="topMargin"><number>24</number></property>

            <property name="rightMargin"><number>28</number></property>

            <property name="bottomMargin"><number>24</number></property>



            <item><widget class="QLabel" name="lblResHeaderTitle"><property name="text"><string>Resource &amp; Storage Monitor</string></property><property name="styleSheet"><string notr="true">font-size: 20px; font-weight: 700; color: #ffffff;</string></property></widget></item>

            <item><widget class="QLabel" name="lblResHeaderDesc"><property name="text"><string>Process memory telemetry, storage breakdown for monitor.log, and growth projections.</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-size: 13px;</string></property></widget></item>



            <!-- Resource Metric Cards -->

            <item>

             <layout class="QHBoxLayout" name="resCardsRow">

              <property name="spacing"><number>16</number></property>



              <!-- CPU Metric -->

              <item>

               <widget class="QFrame" name="cardAppCpu">

                <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 10px; padding: 14px;</string></property>

                <layout class="QVBoxLayout">

                 <item><widget class="QLabel"><property name="text"><string>Application CPU</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600; font-size: 12px;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValAppCpu"><property name="text"><string>0.0 %</string></property><property name="styleSheet"><string notr="true">font-size: 24px; font-weight: 800; color: #38bdf8;</string></property></widget></item>

                 <item><widget class="QLabel"><property name="text"><string>Current process core utilization</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>

                </layout>

               </widget>

              </item>



              <!-- RAM Metric -->

              <item>

               <widget class="QFrame" name="cardAppRam">

                <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 10px; padding: 14px;</string></property>

                <layout class="QVBoxLayout">

                 <item><widget class="QLabel"><property name="text"><string>Application Memory</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600; font-size: 12px;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValAppRam"><property name="text"><string>-- MB</string></property><property name="styleSheet"><string notr="true">font-size: 24px; font-weight: 800; color: #a855f7;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValSysRam"><property name="text"><string>System RAM: --% Used</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>

                </layout>

               </widget>

              </item>



              <!-- Log Size Metric -->

              <item>

               <widget class="QFrame" name="cardLogSize">

                <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 10px; padding: 14px;</string></property>

                <layout class="QVBoxLayout">

                 <item><widget class="QLabel"><property name="text"><string>Current monitor.log Size</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600; font-size: 12px;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValLogSize"><property name="text"><string>0.00 KB</string></property><property name="styleSheet"><string notr="true">font-size: 24px; font-weight: 800; color: #34d399;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValTotalEntries"><property name="text"><string>Storage: storage/monitor.log</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>

                </layout>

               </widget>

              </item>



              <!-- Growth Projection Metric -->

              <item>

               <widget class="QFrame" name="cardLogRate">

                <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 10px; padding: 14px;</string></property>

                <layout class="QVBoxLayout">

                 <item><widget class="QLabel"><property name="text"><string>Baseline Log Growth</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600; font-size: 12px;</string></property></widget></item>

                 <item><widget class="QLabel" name="lblValLogRate"><property name="text"><string>-- B/s</string></property><property name="styleSheet"><string notr="true">font-size: 24px; font-weight: 800; color: #fbbf24;</string></property></widget></item>

                 <item><widget class="QLabel"><property name="text"><string>Based on last 5 min automatic checks</string></property><property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px;</string></property></widget></item>

                </layout>

               </widget>

              </item>



             </layout>

            </item>



            <!-- Storage Breakdown -->

            <item>

             <widget class="QFrame" name="frameStorageBreakdown">

              <property name="styleSheet"><string notr="true">background-color: #131d33; border: 1px solid #1e293b; border-radius: 12px; padding: 18px;</string></property>

              <layout class="QVBoxLayout">

               <property name="spacing"><number>14</number></property>



               <item><widget class="QLabel"><property name="text"><string>Storage Breakdown: Scheduled vs Manual Checks</string></property><property name="styleSheet"><string notr="true">font-size: 15px; font-weight: 700; color: #ffffff;</string></property></widget></item>

               

               <item>

                <layout class="QGridLayout">

                 <property name="horizontalSpacing"><number>20</number></property>

                 <property name="verticalSpacing"><number>10</number></property>



                 <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Scheduled Checks Growth:</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600;</string></property></widget></item>

                 <item row="0" column="1"><widget class="QLabel" name="lblValScheduledGrowth"><property name="text"><string>0 KB (0% of tracked delta)</string></property><property name="styleSheet"><string notr="true">color: #38bdf8; font-weight: 700;</string></property></widget></item>



                 <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Manual User Checks Growth:</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600;</string></property></widget></item>

                 <item row="1" column="1"><widget class="QLabel" name="lblValManualGrowth"><property name="text"><string>0 KB (0 manual checks executed)</string></property><property name="styleSheet"><string notr="true">color: #fbbf24; font-weight: 700;</string></property></widget></item>



                 <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Expected Log Size after 12 Hours:</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600;</string></property></widget></item>

                 <item row="2" column="1"><widget class="QLabel" name="lblValProj12h"><property name="text"><string>-- KB (calculating baseline...)</string></property><property name="styleSheet"><string notr="true">color: #a3e635; font-weight: 700;</string></property></widget></item>



                 <item row="3" column="0"><widget class="QLabel"><property name="text"><string>Expected Log Size after 24 Hours:</string></property><property name="styleSheet"><string notr="true">color: #94a3b8; font-weight: 600;</string></property></widget></item>

                 <item row="3" column="1"><widget class="QLabel" name="lblValProj24h"><property name="text"><string>-- KB (calculating baseline...)</string></property><property name="styleSheet"><string notr="true">color: #4ade80; font-weight: 700;</string></property></widget></item>

                </layout>

               </item>



               <!-- Client Summary Banner -->

               <item>

                <widget class="QFrame" name="frameClientNotice">

                 <property name="styleSheet"><string notr="true">background-color: #0f172a; border-left: 4px solid #38bdf8; border-radius: 6px; padding: 12px; margin-top: 6px;</string></property>

                 <layout class="QVBoxLayout">

                  <item><widget class="QLabel"><property name="text"><string>Log Growth &amp; Stability Analysis:</string></property><property name="styleSheet"><string notr="true">font-weight: 700; color: #38bdf8; font-size: 13px;</string></property></widget></item>

                  <item><widget class="QLabel" name="lblClientExplanation"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Log growth is driven primarily by automatic background server schedules. Manual batch checks and inspector triggers add immediate log entries outside normal schedule cadence.</string></property><property name="styleSheet"><string notr="true">color: #cbd5e1; font-size: 12px; line-height: 140%;</string></property></widget></item>

                 </layout>

                </widget>

               </item>



              </layout>

             </widget>

            </item>



            <item><spacer name="spResBottom"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>

           </layout>

          </widget>











        </widget>

       </item>



      </layout>

     </widget>

    </item>



   </layout>

  </widget>



  </widget>



