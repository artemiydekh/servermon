                     <item><widget class="QLabel" name="lblQuickUptime"><property name="text"><string>100.0%</string></property><property name="styleSheet"><string notr="true">font-size: 11px; font-weight: 700; color: #10b981;</string></property></widget></item>

                    </layout>

